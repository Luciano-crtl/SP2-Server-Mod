<Project Sdk="Microsoft.NET.Sdk">
	<!-- Tests of the mod's model, files, activity XML, the referee's decisions and the chat messages, run OUTSIDE the game.
	     They load the mod's DLL and the game's own DLLs (the game's parser and chat code are what is tested against).
	     Build the mod first (dotnet build SP2-Server-Mod\SP2-Server-Mod.csproj), then run this project with dotnet run (from this folder)
	     Not testable here: anything that needs Unity's native code (the craft hash, Quaternion.Euler) or a running game. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\SimplePlanes 2</GameDir>
		<ManagedDir>$(GameDir)\SimplePlanes 2_Data\Managed</ManagedDir>
		<ModConfiguration Condition="'$(ModConfiguration)' == ''">Debug</ModConfiguration>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="SP2ServerMod"><HintPath>$(MSBuildThisFileDirectory)..\..\SP2-Server-Mod\bin\$(ModConfiguration)\netstandard2.1\SP2ServerMod.dll</HintPath></Reference>
		<Reference Include="Game"><HintPath>$(ManagedDir)\Game.dll</HintPath></Reference>
		<Reference Include="Jundroo.Common"><HintPath>$(ManagedDir)\Jundroo.Common.dll</HintPath></Reference>
		<Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath></Reference>
		<Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath></Reference>
		<Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath></Reference>
		<Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath></Reference>
		<Reference Include="FishNet.Runtime"><HintPath>$(ManagedDir)\FishNet.Runtime.dll</HintPath></Reference>
	</ItemGroup>
	<ItemGroup>
		<None Include="test.match.xml" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
